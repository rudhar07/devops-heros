# Example only - copy to .env for a local run. Fake demo values, not real secrets.
# Either set DATABASE_URL directly ...
# DATABASE_URL=postgresql+psycopg://taskboard:demo-password-123@localhost:5432/taskboard
# ... or the parts (this is how Kubernetes passes them: ConfigMap + Secret).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskboard
DB_USER=taskboard
DB_PASSWORD=demo-password-123
APP_ENV=local
LOG_LEVEL=INFO
