# Rendered at container start by the nginx image's envsubst step
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/). Only variables that
# exist in the environment are replaced, so nginx's own $uri etc. are safe.
#   BACKEND_URL  where /api is proxied to
#                Compose:    http://backend:8000
#                Kubernetes: http://<release>-taskboard-backend:8000 (set by Helm)
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # nginx's own liveness/readiness endpoint (does not depend on the backend)
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Hashed Vite assets can be cached for a long time
  location /assets/ {
    expires 7d;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Single page app: unknown paths fall back to index.html
  location / {
    try_files $uri /index.html;
  }

  # API proxy for Docker Compose and in-cluster traffic. In Kubernetes the
  # Ingress sends /api straight to the backend Service, so this is a fallback.
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
  }
}
