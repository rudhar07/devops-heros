# Remote state for real AWS. Copy to backend.tf, create the bucket once
# (e.g. with this project's own artifacts bucket in a bootstrap stack), then
# run: terraform init -migrate-state
terraform {
  backend "s3" {
    bucket       = "taskboard-tfstate-<account-id>"
    key          = "final-project/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true # S3-native state locking (Terraform >= 1.10), no DynamoDB table needed
  }
}
